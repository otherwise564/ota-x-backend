generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MessageType {
  TEXT
  VOICE
  IMAGE
  VIDEO
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  SHARE
  REPOST
  FAVORITE
  MESSAGE
  MENTION
  SYSTEM
}

enum ReportType {
  POST
  USER
  COMMENT
  MESSAGE
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  password String

  role Role @default(USER)

  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  isVerified Boolean @default(false)

  passwordResetCode      String?
  passwordResetExpiresAt DateTime?

  avatarUrl String?
  bio       String?
  country   String?
  region    String?

  isCreatorVerified Boolean @default(false)
  isActive          Boolean @default(true)

  lastSeenAt DateTime?

  posts Post[]
  likes Like[]
  comments Comment[]
  commentLikes CommentLike[]
  favorites Favorite[]
  shares Share[]
  reposts Repost[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  followRequestsSent FollowRequest[] @relation("FollowRequestsSent")
  followRequestsReceived FollowRequest[] @relation("FollowRequestsReceived")

  sentMessages Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")

  conversationMembers ConversationMember[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent Notification[] @relation("NotificationActor")

  stories Story[]

  liveSessions LiveSession[] @relation("LiveHost")

  reportsMade Report[] @relation("ReportCreator")
  reportsReceived Report[] @relation("ReportedUser")

  settings UserSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([lastSeenAt])
}

model Post {
  id Int @id @default(autoincrement())

  caption String?

  mediaUrl String?
  thumbnailUrl String?

  mediaType MediaType @default(TEXT)

  durationSeconds Int?

  song String?
  soundUrl String?

  hashtags String[] @default([])
  mentions String[] @default([])

  authorId Int
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes Like[]
  comments Comment[]
  favorites Favorite[]
  shares Share[]
  reposts Repost[]
  reports Report[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([mediaType])
}

model Like {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Favorite {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Share {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

model Repost {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  comment String?

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id Int @id @default(autoincrement())

  text String?
  voiceUrl String?

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId Int?

  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)

  replies Comment[] @relation("CommentReplies")

  likes CommentLike[]
  reports Report[]
  notifications Notification[]

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model CommentLike {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId Int
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
}

model Follow {
  id Int @id @default(autoincrement())

  followerId Int
  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  followingId Int
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
  @@index([createdAt])
}

model FollowRequest {
  id Int @id @default(autoincrement())

  requesterId Int
  requester User @relation("FollowRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)

  targetId Int
  target User @relation("FollowRequestsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  status FollowRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, targetId])
  @@index([requesterId])
  @@index([targetId])
  @@index([status])
  @@index([createdAt])
}

model Conversation {
  id Int @id @default(autoincrement())

  directKey String?

  members ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model ConversationMember {
  id Int @id @default(autoincrement())

  conversationId Int
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id Int @id @default(autoincrement())

  conversationId Int
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId Int
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId Int
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  type MessageType @default(TEXT)

  text String?
  mediaUrl String?
  voiceUrl String?

  isRead Boolean @default(false)

  reports Report[]

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([receiverId, isRead])
}

model Notification {
  id Int @id @default(autoincrement())

  recipientId Int
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId Int?
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  type NotificationType
  message String

  postId Int?
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId Int?
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@index([createdAt])
}

model Story {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaUrl String?
  mediaType MediaType @default(IMAGE)

  text String?
  durationSeconds Int?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model LiveSession {
  id Int @id @default(autoincrement())

  hostId Int
  host User @relation("LiveHost", fields: [hostId], references: [id], onDelete: Cascade)

  title String?

  status LiveStatus @default(SCHEDULED)

  startedAt DateTime?
  endedAt DateTime?

  createdAt DateTime @default(now())

  @@index([hostId])
  @@index([status])
  @@index([createdAt])
}

model Report {
  id Int @id @default(autoincrement())

  reporterId Int
  reporter User @relation("ReportCreator", fields: [reporterId], references: [id], onDelete: Cascade)

  reportedUserId Int?
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  postId Int?
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId Int?
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  messageId Int?
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  type ReportType
  reason String

  status ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([postId])
  @@index([commentId])
  @@index([messageId])
}

model UserSettings {
  id Int @id @default(autoincrement())

  userId Int @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  darkMode Boolean @default(true)

  notifications Boolean @default(true)
  notifyLikes Boolean @default(true)
  notifyComments Boolean @default(true)
  notifyFollowers Boolean @default(true)
  notifyMessages Boolean @default(true)
  notifyMentions Boolean @default(true)
  notifyReposts Boolean @default(true)
  notifyFavorites Boolean @default(true)
  notifySystem Boolean @default(true)

  privateAccount Boolean @default(false)

  showActivityStatus Boolean @default(true)

  allowComments Boolean @default(true)
  allowMessages Boolean @default(true)
  allowMessageRequests Boolean @default(true)

  showReadStatus Boolean @default(true)

  autoplayVideos Boolean @default(true)
  dataSaver Boolean @default(false)

  suggestMyAccount Boolean @default(true)

  allowMentions Boolean @default(true)
  allowTags Boolean @default(true)

  loginAlerts Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
