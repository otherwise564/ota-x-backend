generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MessageType {
  TEXT
  VOICE
  IMAGE
  VIDEO
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  SHARE
  REPOST
  FAVORITE
  MESSAGE
  MENTION
  SYSTEM
}

enum ReportType {
  POST
  USER
  COMMENT
  MESSAGE
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  password String

  role Role @default(USER)

  // Email verification
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  isVerified                Boolean  @default(false)

  // Password reset
  passwordResetCode      String?
  passwordResetExpiresAt DateTime?

  // Profile
  avatarUrl String?
  bio       String?

  // Country/region preference
  // This information should not be exposed publicly by default.
  country String?
  region  String?

  // Creator verification
  isCreatorVerified Boolean @default(false)

  // Account state
  isActive  Boolean  @default(true)
  lastSeenAt DateTime?

  // Relationships
  posts        Post[]
  likes        Like[]
  comments     Comment[]
  commentLikes CommentLike[]
  favorites    Favorite[]
  shares       Share[]
  reposts      Repost[]

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  sentMessages     Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")

  conversationMembers ConversationMember[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")

  stories      Story[]
  liveSessions LiveSession[] @relation("LiveHost")

  reportsMade     Report[] @relation("ReportCreator")
  reportsReceived Report[] @relation("ReportedUser")

  settings UserSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([lastSeenAt])
}

model Post {
  id Int @id @default(autoincrement())

  caption String?

  mediaUrl   String?
  thumbnailUrl String?
  mediaType  MediaType @default(TEXT)

  // Optional metadata for video/media
  durationSeconds Int?

  // Sound information
  song      String?
  soundUrl  String?

  hashtags String[] @default([])
  mentions String[] @default([])

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes     Like[]
  comments  Comment[]
  favorites Favorite[]
  shares    Share[]
  reposts   Repost[]

  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([mediaType])
}

model Like {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Favorite {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Share {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

model Repost {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  comment String?

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id Int @id @default(autoincrement())

  text     String?
  voiceUrl String?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Replies
  parentId Int?
  parent   Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  likes CommentLike[]

  reports Report[]

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([parentId])
  @@index([userId])
  @@index([createdAt])
}

model CommentLike {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
}

model Follow {
  id Int @id @default(autoincrement())

  followerId Int
  follower   User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  followingId Int
  following   User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Prevent duplicate follows
  @@unique([followerId, followingId])

  @@index([followingId])
  @@index([followerId])
  @@index([createdAt])
}

model Conversation {
  id Int @id @default(autoincrement())

  // Optional key for a direct/private conversation.
  // Group conversations can leave this null.
  directKey String? @unique

  members  ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model ConversationMember {
  id Int @id @default(autoincrement())

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id Int @id @default(autoincrement())

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId Int
  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId Int
  receiver   User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  type MessageType @default(TEXT)

  text     String?
  mediaUrl String?
  voiceUrl String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([receiverId, isRead])
}

model Notification {
  id Int @id @default(autoincrement())

  recipientId Int
  recipient   User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId Int?
  actor   User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  type    NotificationType
  message String

  // Related content IDs
  postId    Int?
  commentId Int?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@index([createdAt])
}

model Story {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaUrl   String?
  mediaType  MediaType @default(IMAGE)
  text       String?
  durationSeconds Int?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model LiveSession {
  id Int @id @default(autoincrement())

  hostId Int
  host   User @relation("LiveHost", fields: [hostId], references: [id], onDelete: Cascade)

  title  String?
  status LiveStatus @default(SCHEDULED)

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([hostId])
  @@index([status])
  @@index([createdAt])
}

model Report {
  id Int @id @default(autoincrement())

  reporterId Int
  reporter   User @relation("ReportCreator", fields: [reporterId], references: [id], onDelete: Cascade)

  reportedUserId Int?
  reportedUser   User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  postId Int?
  post   Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId Int?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  type   ReportType
  reason String
  status ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([postId])
  @@index([commentId])
}

model UserSettings {
  id Int @id @default(autoincrement())

  userId Int @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  darkMode       Boolean @default(true)
  notifications  Boolean @default(true)
  privateAccount Boolean @default(false)
  allowMessages  Boolean @default(true)
  allowComments  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
